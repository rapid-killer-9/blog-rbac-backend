# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blog_rbac?schema=public"

# JWT — set a long, random secret (e.g. openssl rand -hex 64)
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="1h"

# Server
PORT=3000

# CORS — comma-separated origins, or * for development only
CORS_ORIGIN="http://localhost:3000"
